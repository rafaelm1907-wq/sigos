NODE_ENV=production
PORT=7000
HOST=127.0.0.1
DATABASE_URL=postgresql://epiapp:ALTERE_ESTA_SENHA@127.0.0.1:5432/epi_checklist
JWT_SECRET=GERE_UM_SEGREDO_LONGO_E_ALEATORIO
COOKIE_SECURE=true
ENFORCE_HTTPS=true

# Opcional: notificações push via Firebase Admin SDK.
# Nunca versione o JSON da conta de serviço.
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/epi-checklist/firebase-service-account.json

# Web Push para PWA no Android e no iPhone/iPad (gere um par VAPID por ambiente).
WEB_PUSH_SUBJECT=mailto:suporte@lvltech.com.br
WEB_PUSH_PUBLIC_KEY=GERAR_CHAVE_PUBLICA_VAPID
WEB_PUSH_PRIVATE_KEY=GERAR_CHAVE_PRIVADA_VAPID

# Opcional: defaults neutros usados antes de o Admin cadastrar a empresa.
DEFAULT_COMPANY_TRADE_NAME=Empresa SIGOS
DEFAULT_COMPANY_LEGAL_NAME=Empresa SIGOS
DEFAULT_COMPANY_CNPJ=

SIGOS_SELFIE_PATH=/opt/epi-checklist/storage/selfies
SIGOS_APK_PATH=/opt/epi-checklist/releases/sigos.apk

# Atualização controlada pelo Superadmin. O script usa somente esta URL e branch.
SIGOS_UPDATE_REPO_URL=https://github.com/rafaelm1907-wq/sigos.git
SIGOS_UPDATE_BRANCH=feature/vehicle-inventory
SIGOS_UPDATE_STATUS_PATH=/opt/epi-checklist/.update/status.json
SIGOS_UPDATE_BACKUP_DIR=/opt/epi-checklist/.update/backups

# Bootstrap executado somente se ainda não houver usuário com o e-mail informado.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ALTERE_IMEDIATAMENTE

# Opcional: Superadmin inicial do sistema. Use um identificador de login único.
BOOTSTRAP_SUPERADMIN_NAME=Rafael
BOOTSTRAP_SUPERADMIN_EMAIL=rafael
BOOTSTRAP_SUPERADMIN_PASSWORD=ALTERE_IMEDIATAMENTE

